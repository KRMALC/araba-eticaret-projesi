# OpenAI (https://platform.openai.com/api-keys)
# Bu dosyayı kopyalayıp .env adıyla kaydedin; .env asla GitHub'a eklenmez.

OPENAI_API_KEY=

# İsteğe bağlı (varsayılan: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-4o-mini

# Chat sunucusu portu (varsayılan: 5001)
# PORT=5001

# CORS: Flask / Live Server adresleri (virgülle)
# CHAT_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
